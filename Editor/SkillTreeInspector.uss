.skill-tree-inspector {
    padding-top: 4px;
}
.skill-tree-columns {
    flex-direction: row;
    align-items: flex-start;
}
.skill-tree-columns.narrow {
    flex-direction: column;
    align-items: stretch;
}
.skill-tree-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 250px;
    padding-right: 6px;
}
.skill-tree-columns.narrow > .skill-tree-column {
    flex-basis: auto;
    padding-right: 0;
}
.skill-tree-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 6px;
}
.skill-tree-actions > Button {
    flex-grow: 1;
    margin-right: 4px;
}
.skill-tree-help {
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 6px;
}
.skill-tree-hidden {
    display: none;
}
.skill-tree-resolver-details {
    margin-left: 18px;
    margin-bottom: 5px;
    padding-left: 6px;
    border-left-width: 2px;
    border-left-color: rgba(128, 128, 128, 0.35);
}
.skill-tree-resolver-implementation {
    font-size: 11px;
    opacity: 0.7;
    white-space: normal;
    margin-top: 0;
    margin-bottom: 2px;
}
